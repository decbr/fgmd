{
	"name": "fgmd",
	"version": "0.1.0",
	"description": "A fucking good Markdown parser. CommonMark + GFM, zero dependencies, safe by default, with an HTML renderer, a Svelte renderer and a CLI.",
	"license": "MIT",
	"author": "Dec",
	"type": "module",
	"keywords": [
		"markdown",
		"commonmark",
		"gfm",
		"parser",
		"mdast",
		"svelte",
		"html"
	],
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./svelte": {
			"types": "./dist/svelte/index.d.ts",
			"svelte": "./dist/svelte/index.js",
			"default": "./dist/svelte/index.js"
		},
		"./package.json": "./package.json"
	},
	"bin": {
		"fgmd": "./dist/cli.js"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*"
	],
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"build": "node scripts/build.mjs",
		"test": "vitest run",
		"check": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --threshold error",
		"spec": "node scripts/spec-report.mjs",
		"fetch-spec": "node scripts/fetch-spec.mjs",
		"gen-entities": "node scripts/gen-entities.mjs",
		"prepack": "npm run build"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"peerDependenciesMeta": {
		"svelte": {
			"optional": true
		}
	},
	"devDependencies": {
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/node": "^22.20.2",
		"esbuild": "^0.28.2",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vitest": "^5.0.0"
	}
}
