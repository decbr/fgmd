{
	"name": "@decbr/fgmd",
	"version": "0.4.0",
	"description": "a f***ing good markdown parser.",
	"license": "MIT",
	"author": "decbr",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/decbr/fgmd.git"
	},
	"homepage": "https://github.com/decbr/fgmd#readme",
	"bugs": "https://github.com/decbr/fgmd/issues",
	"type": "module",
	"keywords": [
		"markdown",
		"commonmark",
		"gfm",
		"parser",
		"mdast",
		"svelte",
		"html"
	],
	"sideEffects": false,
	"imports": {
		"#named-entity": {
			"workerd": "./dist/named-entity.js",
			"worker": "./dist/named-entity.js",
			"browser": "./dist/named-entity.browser.js",
			"default": "./dist/named-entity.js"
		}
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./emoji": {
			"types": "./dist/emoji.d.ts",
			"default": "./dist/emoji.js"
		},
		"./svelte": {
			"types": "./dist/svelte/index.d.ts",
			"svelte": "./dist/svelte/index.js",
			"default": "./dist/svelte/index.js"
		},
		"./package.json": "./package.json"
	},
	"bin": {
		"fgmd": "dist/cli.js"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*"
	],
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"build": "node scripts/build.mjs",
		"test": "vitest run",
		"check": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --threshold error",
		"size": "node scripts/size.mjs",
		"spec": "node scripts/spec-report.mjs",
		"fetch-spec": "node scripts/fetch-spec.mjs",
		"gen-entities": "node scripts/gen-entities.mjs",
		"prepack": "npm run build",
		"version": "node scripts/sync-version.mjs && git add src/version.ts"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"peerDependenciesMeta": {
		"svelte": {
			"optional": true
		}
	},
	"devDependencies": {
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/jsdom": "^30.0.0",
		"@types/node": "^22.20.2",
		"esbuild": "^0.28.2",
		"jsdom": "^30.0.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vitest": "^5.0.0"
	}
}
