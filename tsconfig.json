{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"declaration": true,
		"types": ["node"]
	},
	"include": ["src/**/*.ts", "src/**/*.svelte", "test/**/*.ts", "types/**/*.d.ts"]
}
